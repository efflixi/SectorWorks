<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>0.6.0-dev</Version>
    <OutputType Condition="$(RuntimeIdentifier.StartsWith('win-')) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')))">WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SectorWorks.Core/SectorWorks.Core.csproj" />
    <ProjectReference Include="../SectorWorks.Services/SectorWorks.Services.csproj" />
    <ProjectReference Include="../SectorWorks.Platform/SectorWorks.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Themes/ICONS-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="licenses/SectorWorks-Compact-Icons.txt" />
  </ItemGroup>
  <Target Name="ArrangeSectorWorksRelease" AfterTargets="ComputeFilesToPublish" Condition="'$(SectorWorksReleaseLayout)' == 'true'">
    <Error Condition="'$(SelfContained)' != 'true' or '$(PublishSingleFile)' == 'true' or '$(AppHostSourcePath)' == ''"
           Text="The SectorWorks release layout requires a self-contained apphost and separate runtime files." />
    <PropertyGroup>
      <_SectorWorksLauncher>$(IntermediateOutputPath)sectorworks-release$(_NativeExecutableExtension)</_SectorWorksLauncher>
    </PropertyGroup>
    <!-- Bind the standard .NET apphost directly to the relocated application. -->
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(_SectorWorksLauncher)"
                   AppBinaryName="libs/$(AssemblyName)$(TargetExt)"
                   IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                   WindowsGraphicalUserInterface="$(_UseWindowsGraphicalUserInterface)" />
    <ItemGroup>
      <ResolvedFileToPublish Remove="$(AppHostIntermediatePath)" />
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             Condition="!$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('licenses/'))">
        <RelativePath>libs/%(ResolvedFileToPublish.RelativePath)</RelativePath>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(_SectorWorksLauncher)">
        <RelativePath>SectorWorks$(_NativeExecutableExtension)</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
